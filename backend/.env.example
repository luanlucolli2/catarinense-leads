# Em backend/.env.example

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# A porta 8080 é a porta que o contêiner do frontend irá expor
# Manter localhost aqui é o correto para o ambiente Docker universal
SANCTUM_STATEFUL_DOMAINS=localhost:8080
SESSION_DOMAIN=localhost
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file
REDIS_QUEUE_RETRY_AFTER=115500

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# CLT
CLT_LOG_ENABLED=true
CLT_FACTA_LOG_RESPONSES=true
CLT_FACTA_LOG_SUCCESS_RESPONSES=false
CLT_CHUNK_PERF_DEBUG=false
CLT_FLUSH_PROGRESS_LOG=false
CLT_BACKOFF_LOG=false
CLT_HTTP_AUTORIZA_POOL_WINDOW=3
CLT_HTTP_POLICY_POOL_WINDOW=4
FACTA_CLT_CREDITO_POLICY_BATCH_SIZE=4
# Valores: operacoes (legado) | fixed (teste com valor/prazos fixos)
FACTA_CLT_CREDITO_POLICY_SOURCE_MODE=operacoes
FACTA_CLT_CREDITO_POLICY_FIXED_VALOR_EMPRESTIMO=500
FACTA_CLT_CREDITO_POLICY_FIXED_PRAZOS=6,8,10,12,14,15,18,20,24,30,36,42,48
CLT_JOB_STATUS_CHECK_INTERVAL_MS=1000
CLT_JOB_ROWS_BUFFER_FLUSH=200
CLT_JOB_SNAP_BUFFER_FLUSH=200
FACTA_PRE_AUTH_CACHE_TTL_SECONDS=1800
FACTA_PRE_AUTH_PHONE_RETRY_ATTEMPTS=3
CLT_ON_JOB_QUEUE=clt-consulta-online
CLT_PHASE2_JOB_QUEUE=clt-valida-politica-cred
CLT_OFF_JOB_QUEUE=clt-off
CLT_ON_JOB_TIMEOUT=18000
CLT_PHASE2_JOB_TIMEOUT=18000
CLT_OFF_JOB_TIMEOUT=18000
CLT_CREDIT_PHASE2_PENDING_FLUSH_EVERY_ROWS=50
CLT_JOB_MEMORY_SOFT_LIMIT_MB=0
CLT_JOB_MEMORY_SPILL_THRESHOLD_PERCENT=70

# PRESENCA
PRESENCA_BASE_URL=https://presenca-bank-api.azurewebsites.net
PRESENCA_LOGIN=
PRESENCA_SENHA=
PRESENCA_TENANT_ID=superuser
PRESENCA_PRODUTO_ID=28
PRESENCA_MIN_INTERVAL_MS=2000
PRESENCA_MAX_REQUESTS_PER_MINUTE=30
PRESENCA_SIMULACAO_RETRY_ATTEMPTS=12
PRESENCA_AUTH_REUSE_TTL_SECONDS=172800
PRESENCA_JOB_QUEUE=presenca
PRESENCA_PREVIEW_QUEUE=reports
PRESENCA_REPORTS_DISK=local
PRESENCA_REPORTS_DIR=presenca-reports
PRESENCA_SPOOL_DIR=presenca-spool
PRESENCA_FINAL_PREFIX=presenca-consulta

# C6
C6_BASE_URL=https://marketplace-proposal-service-api-p.c6bank.info
C6_USERNAME=
C6_PASSWORD=
C6_HTTP_TIMEOUT=10
C6_HTTP_CONNECT_TIMEOUT=5
C6_HTTP_RETRY=1
C6_HTTP_RETRY_DELAY_MS=200
C6_TOKEN_TTL_SECONDS=1199
C6_TOKEN_TTL_SKEW=60
C6_AUTHORIZATION_GENERATE_ACCEPT=application/vnd.c6bank_authorization_generate_liveness_v1+json

# UY3
UY3_WEBHOOK_SECRET=
