# Em backend/.env.example

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# A porta 8080 é a porta que o contêiner do frontend irá expor
# Manter localhost aqui é o correto para o ambiente Docker universal
SANCTUM_STATEFUL_DOMAINS=localhost:8080
SESSION_DOMAIN=localhost
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# CLT
CLT_LOG_ENABLED=true
CLT_FACTA_LOG_RESPONSES=true
CLT_FACTA_LOG_SUCCESS_RESPONSES=false
CLT_CHUNK_PERF_DEBUG=false
CLT_FLUSH_PROGRESS_LOG=false
CLT_BACKOFF_LOG=false
CLT_JOB_ROWS_BUFFER_FLUSH=300
CLT_JOB_SNAP_BUFFER_FLUSH=300

# C6
C6_BASE_URL=https://marketplace-proposal-service-api-p.c6bank.info
C6_USERNAME=
C6_PASSWORD=
C6_HTTP_TIMEOUT=10
C6_HTTP_CONNECT_TIMEOUT=5
C6_HTTP_RETRY=1
C6_HTTP_RETRY_DELAY_MS=200
C6_TOKEN_TTL_SECONDS=1199
C6_TOKEN_TTL_SKEW=60
C6_AUTHORIZATION_GENERATE_ACCEPT=application/vnd.c6bank_authorization_generate_liveness_v1+json
