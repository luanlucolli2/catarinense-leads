# Em backend/.env.example

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Inclui frontend Docker (:8080) e frontend Vite local (:5173)
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080,localhost:5173,127.0.0.1:5173
LOGIN_RATE_LIMIT_IP_PER_MINUTE=120
LOGIN_RATE_LIMIT_IDENTIFIER_PER_MINUTE=120
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
SESSION_DOMAIN=localhost
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file
REDIS_QUEUE_RETRY_AFTER=18030

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# CLT
CLT_LOG_ENABLED=true
CLT_FACTA_LOG_RESPONSES=true
CLT_FACTA_LOG_SUCCESS_RESPONSES=false
CLT_CHUNK_PERF_DEBUG=false
CLT_FLUSH_PROGRESS_LOG=false
CLT_BACKOFF_LOG=false
CLT_HTTP_AUTORIZA_POOL_WINDOW=3
CLT_HTTP_POLICY_POOL_WINDOW=4
FACTA_CLT_CREDITO_POLICY_BATCH_SIZE=4
CLT_JOB_STATUS_CHECK_INTERVAL_MS=1000
CLT_JOB_ROWS_BUFFER_FLUSH=200
CLT_JOB_SNAP_BUFFER_FLUSH=200
FACTA_PRE_AUTH_CACHE_TTL_SECONDS=1800
FACTA_PRE_AUTH_PHONE_RETRY_ATTEMPTS=3
CLT_ON_JOB_QUEUE=clt-consulta-online
CLT_PHASE2_JOB_QUEUE=clt-valida-politica-cred
CLT_OFF_JOB_QUEUE=clt-off
CLT_ON_JOB_TIMEOUT=18000
CLT_PHASE2_JOB_TIMEOUT=18000
CLT_OFF_JOB_TIMEOUT=18000
CLT_CREDIT_PHASE2_PENDING_FLUSH_EVERY_ROWS=50
CLT_JOB_MEMORY_SOFT_LIMIT_MB=0
CLT_JOB_MEMORY_SPILL_THRESHOLD_PERCENT=70

# C6
C6_BASE_URL=https://marketplace-proposal-service-api-p.c6bank.info
C6_USERNAME=
C6_PASSWORD=
C6_HTTP_TIMEOUT=10
C6_HTTP_CONNECT_TIMEOUT=5
C6_HTTP_RETRY=1
C6_HTTP_RETRY_DELAY_MS=200
C6_TOKEN_TTL_SECONDS=1199
C6_TOKEN_TTL_SKEW=60
C6_AUTHORIZATION_GENERATE_ACCEPT=application/vnd.c6bank_authorization_generate_liveness_v1+json

# UY3
UY3_WEBHOOK_SECRET=
