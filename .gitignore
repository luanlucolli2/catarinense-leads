# .gitignore Unificado para o Monorepo Catarinense Leads

# --------------------------------------
# Arquivos de Ambiente e Segredos
# --------------------------------------
.env
.env.*
!.env.example

# --------------------------------------
# Sistema Operacional e Editores de Código
# --------------------------------------
.DS_Store
Thumbs.db

*.swo
*.swp

/.idea/
/.vscode/
/.fleet/
/.zed/

# --------------------------------------
# Logs e Arquivos Gerados
# --------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --------------------------------------
# Metadados do Windows (origem do seu problema)
# --------------------------------------
*Zone.Identifier

# --------------------------------------
# Backend: Laravel (pasta backend/)
# --------------------------------------

# Dependências do Composer
/backend/vendor/

# Dependências do NPM/Yarn no backend (se houver)
#/backend/node_modules/

# Arquivo de autenticação do Composer
/backend/auth.json

# Cache de testes do PHPUnit
/backend/.phpunit.cache/
/backend/.phpunit.result.cache
.phpunit.result.cache

# Cache e bootstrap do Laravel
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore

# Storage do Laravel (logs, cache, uploads, etc.)
/backend/storage/*
!/backend/storage/.gitignore

# Em particular, o symlink criado pelo storage:link
/backend/public/storage

# Arquivos gerados pelo Laravel Pail
/backend/storage/pail/

# Arquivos gerados pelo Scribe (documentação de API)
/backend/public/vendor/scribe/
/backend/resources/views/scribe/

# --------------------------------------
# Frontend: React/Vite (lead-import-visualizer/)
# --------------------------------------

# Dependências do NPM
/lead-import-visualizer/node_modules/

# Pastas de build de produção
/lead-import-visualizer/dist/
/lead-import-visualizer/dist-ssr/

# Caches e arquivos temporários comuns do Vite/linters
/lead-import-visualizer/.vite
/lead-import-visualizer/.cache
/lead-import-visualizer/.eslintcache

# Arquivos de configuração local do Vite
*.local

# --------------------------------------
# Raiz do monorepo (caso exista coisa na raiz)
# --------------------------------------

# Node_modules na raiz (se algum script for rodado ali)
/node_modules/

# Pastas de build/cobertura genéricas
/dist/
/build/
/coverage/

# Caches diversos
/.turbo/
/.cache/

# Configurações de gerenciadores de pacotes (se não quiser versionar)
/.pnpm-store/
.npmrc
.yarnrc*
backend/.env.staging
*Zone.Identifier
/backend/storage/*
!/backend/storage/app
!/backend/storage/framework
!/backend/storage/logs

/backend/storage/*.key
/backend/public/storage
lead-import-visualizer/public/catarinenseicon.png:Zone.Identifier
lead-import-visualizer/src/catainenseLogo.png:Zone.Identifier
dist-codex

# Codex local overrides
.codex/*.local.toml
.codex/AGENTS.override.md
backend/docs/especificacao_webhook_outbound_vendeai.txt
backend/docs/api-new-corban.json